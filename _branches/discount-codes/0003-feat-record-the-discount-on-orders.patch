diff --git a/tests/test_db.py b/tests/test_db.py
new file mode 100644
index 0000000..7c68c20
--- /dev/null
+++ b/tests/test_db.py
@@ -0,0 +1,32 @@
+from shop import db
+from shop.money import Money
+from shop.pricing import Line, Price
+
+
+def test_add_order_with_a_discount():
+    conn = db.connect(":memory:")
+    db.add_product(conn, db.Product("TEE", "T-shirt", Money(1500)))
+    db.add_discount_code(conn, db.DiscountCode("SAVE10", 10))
+    lines = [Line("TEE", Money(1500), 2)]
+    price = Price(
+        subtotal=Money(3000), shipping=Money(495), total=Money(3195), discount=Money(300)
+    )
+
+    order_id = db.add_order(conn, lines, price, discount_code="SAVE10")
+
+    order = db.get_order(conn, order_id)
+    assert order.price == price
+    assert order.discount_code == "SAVE10"
+
+
+def test_add_order_without_a_discount():
+    conn = db.connect(":memory:")
+    db.add_product(conn, db.Product("TEE", "T-shirt", Money(1500)))
+    lines = [Line("TEE", Money(1500), 2)]
+    price = Price(subtotal=Money(3000), shipping=Money(495), total=Money(3495))
+
+    order_id = db.add_order(conn, lines, price)
+
+    order = db.get_order(conn, order_id)
+    assert order.price.discount == Money(0)
+    assert order.discount_code is None
