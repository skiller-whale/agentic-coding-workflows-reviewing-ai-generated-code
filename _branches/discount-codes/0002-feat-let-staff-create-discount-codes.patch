--- a/tests/test_api.py
+++ b/tests/test_api.py
@@ -27,6 +27,43 @@ def test_add_product_with_an_existing_sku(client, staff_headers, add_product):
     assert response.status_code == 409
 
 
+def test_add_discount_code(client, staff_headers):
+    response = client.post(
+        "/admin/discount-codes",
+        json={"code": "SAVE10", "percent_off": 10},
+        headers=staff_headers,
+    )
+
+    assert response.status_code == 201
+    assert response.json() == {"code": "SAVE10", "percent_off": 10}
+
+
+def test_add_discount_code_with_an_existing_code(client, staff_headers):
+    client.post(
+        "/admin/discount-codes",
+        json={"code": "SAVE10", "percent_off": 10},
+        headers=staff_headers,
+    )
+
+    response = client.post(
+        "/admin/discount-codes",
+        json={"code": "SAVE10", "percent_off": 20},
+        headers=staff_headers,
+    )
+
+    assert response.status_code == 409
+
+
+def test_discount_codes_can_take_up_to_100_percent_off(client, staff_headers):
+    for percent_off, status_code in [(0, 422), (1, 201), (100, 201), (101, 422)]:
+        response = client.post(
+            "/admin/discount-codes",
+            json={"code": f"CODE{percent_off}", "percent_off": percent_off},
+            headers=staff_headers,
+        )
+        assert response.status_code == status_code, percent_off
+
+
