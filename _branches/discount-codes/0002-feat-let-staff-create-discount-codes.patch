+def get_discount_code(conn: sqlite3.Connection, code: str) -> DiscountCode | None:
+    row = conn.execute("SELECT * FROM discount_codes WHERE code = ?", (code,)).fetchone()
+    if row is None:
+        return None
+    return DiscountCode(row["code"], row["percent_off"])
+
+
+def add_discount_code(conn: sqlite3.Connection, discount_code: DiscountCode) -> None:
+    with conn:
+        conn.execute(
+            "INSERT INTO discount_codes (code, percent_off) VALUES (?, ?)",
+            (discount_code.code, discount_code.percent_off),
+        )
+
