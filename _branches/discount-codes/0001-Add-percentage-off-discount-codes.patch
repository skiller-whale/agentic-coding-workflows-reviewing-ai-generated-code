+from datetime import date
+
+import pytest
+
+from shop.domain.discount_codes import PercentOff, normalise
+from shop.domain.errors import ValidationFailed
+from shop.domain.money import Money
+
+TODAY = date(2026, 6, 15)
+
+
+def test_percent_off():
+    adjustment = PercentOff("SAVE10", None, 10).adjustment(Money(1565))
+    assert adjustment.kind == "discount_code"
+    assert adjustment.description == "10% off with SAVE10"
+    assert adjustment.amount == Money(157)
+
+
+def test_percent_off_of_nothing():
+    assert PercentOff("SAVE10", None, 10).adjustment(Money(0)) is None
+
+
+def test_live_until_the_end_of_the_expiry_date():
+    assert PercentOff("SAVE10", None, 10).is_live(TODAY)
+    assert PercentOff("SAVE10", TODAY, 10).is_live(TODAY)
+    assert not PercentOff("SAVE10", date(2026, 6, 14), 10).is_live(TODAY)
+
+
+def test_normalise():
+    assert normalise(" summer-20 ") == "SUMMER-20"
+
+
+@pytest.mark.parametrize(
+    "discount_code, message",
+    [
+        (PercentOff("SAVE10", None, 0), "between 1 and 100"),
+        (PercentOff("SAVE10", None, 101), "between 1 and 100"),
+        (PercentOff("S", None, 10), "3 to 30"),
+        (PercentOff("SAVE 10", None, 10), "3 to 30"),
+        (PercentOff("SAVE10", date(2026, 6, 14), 10), "already passed"),
+    ],
+)
+def test_check(discount_code, message):
+    with pytest.raises(ValidationFailed, match=message):
+        discount_code.check(TODAY)
+
+
+def test_check_accepts_valid_codes():
+    PercentOff("SAVE10", None, 1).check(TODAY)
+    PercentOff("SUMMER-2026", TODAY, 100).check(TODAY)
