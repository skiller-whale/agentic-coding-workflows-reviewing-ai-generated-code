diff --git a/shop/services/discount_codes.py b/shop/services/discount_codes.py
new file mode 100644
index 0000000..e30a21d
--- /dev/null
+++ b/shop/services/discount_codes.py
@@ -0,0 +1,50 @@
+from dataclasses import asdict, replace
+from datetime import date
+
+from shop import clock
+from shop.db.connection import transaction
+from shop.domain.discount_codes import DiscountCode, normalise
+from shop.domain.errors import NotFound, ValidationFailed
+from shop.domain.models import StaffMember
+from shop.repositories.discount_codes import DiscountCodeRepository
+from shop.services.audit import AuditLog
+
+
+class DiscountCodeService:
+    def __init__(self, codes: DiscountCodeRepository, audit: AuditLog):
+        self.codes = codes
+        self.audit = audit
+
+    def for_checkout(self, code: str) -> DiscountCode:
+        """The code a customer entered, if it exists and hasn't expired."""
+        try:
+            discount_code = self.codes.get(normalise(code))
+        except NotFound:
+            raise ValidationFailed(f"{code!r} isn't a discount code") from None
+        if not discount_code.is_live(clock.today()):
+            raise ValidationFailed(f"The discount code {discount_code.code} has expired")
+        return discount_code
+
+    # --- staff ---
+
+    def list(self) -> list[DiscountCode]:
+        return self.codes.list()
+
+    def create(self, staff: StaffMember, discount_code: DiscountCode) -> DiscountCode:
+        discount_code = replace(discount_code, code=normalise(discount_code.code))
+        discount_code.check(clock.today())
+        details = {
+            name: value.isoformat() if isinstance(value, date) else value
+            for name, value in asdict(discount_code).items()
+            if name != "code"
+        }
+        with transaction(self.codes.conn):
+            self.codes.add(discount_code)
+            self.audit.record(
+                staff,
+                "discount_code.created",
+                f"discount_code:{discount_code.code}",
+                kind=discount_code.kind,
+                **details,
+            )
+        return discount_code
