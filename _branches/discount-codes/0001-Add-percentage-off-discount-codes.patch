+from datetime import UTC, date, datetime
+
+import pytest
+
+from shop import clock
+from shop.domain.discount_codes import PercentOff
+from shop.domain.errors import Conflict, ValidationFailed
+
+
+def test_create(services, make):
+    staff, _ = make.staff()
+    created = services.discount_codes.create(staff, PercentOff("summer-20", date(2026, 8, 31), 20))
+    assert created == PercentOff("SUMMER-20", date(2026, 8, 31), 20)
+    assert services.discount_codes.list() == [created]
+    [entry] = services.audit.entries("discount_code:SUMMER-20")
+    assert entry.action == "discount_code.created"
+    assert entry.details == {"kind": "percent_off", "expires_on": "2026-08-31", "percent": 20}
+
+
+def test_create_duplicate(services, make):
+    staff, _ = make.staff()
+    make.percent_off("SAVE10")
+    with pytest.raises(Conflict):
+        services.discount_codes.create(staff, PercentOff("save10", None, 15))
+
+
+def test_create_invalid_changes_nothing(services, make):
+    staff, _ = make.staff()
+    with pytest.raises(ValidationFailed):
+        services.discount_codes.create(staff, PercentOff("SAVE10", None, 0))
+    assert services.discount_codes.list() == []
+    assert services.audit.entries() == []
+
+
+def test_for_checkout_ignores_case(services, make):
+    code = make.percent_off("SAVE10")
+    assert services.discount_codes.for_checkout(" save10") == code
+
+
+def test_for_checkout_unknown(services):
+    with pytest.raises(ValidationFailed, match="isn't a discount code"):
+        services.discount_codes.for_checkout("NOPE")
+
+
+def test_for_checkout_expired(services, make):
+    make.percent_off("SAVE10", expires_on=date(2026, 6, 14))
+    with pytest.raises(ValidationFailed, match="expired"):
+        services.discount_codes.for_checkout("SAVE10")
+
+
+def test_expiry_is_in_uk_time(services, make, monkeypatch):
+    make.percent_off("SAVE10", expires_on=date(2026, 6, 15))
+    # 23:30 UTC on the 15th is 00:30 BST on the 16th.
+    monkeypatch.setattr(clock, "now", lambda: datetime(2026, 6, 15, 22, 59, tzinfo=UTC))
+    services.discount_codes.for_checkout("SAVE10")
+    monkeypatch.setattr(clock, "now", lambda: datetime(2026, 6, 15, 23, 30, tzinfo=UTC))
+    with pytest.raises(ValidationFailed, match="expired"):
+        services.discount_codes.for_checkout("SAVE10")
