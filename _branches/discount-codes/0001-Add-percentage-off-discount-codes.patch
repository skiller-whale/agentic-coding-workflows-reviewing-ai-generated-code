--- /dev/null
+++ b/shop/domain/discount_codes.py
@@ -0,0 +1,66 @@
+"""Discount codes that customers enter at checkout.
+
+Each kind of code is a subclass of DiscountCode, which says what it takes off an order.
+"""
+
+import re
+from dataclasses import dataclass
+from datetime import date
+from typing import ClassVar
+
+from shop.domain.errors import ValidationFailed
+from shop.domain.models import Adjustment
+from shop.domain.money import Money
+
+CODE_PATTERN = re.compile(r"^[A-Z0-9-]{3,30}$")
+
+
+def normalise(code: str) -> str:
+    """Codes are case-insensitive, so they're stored and looked up in upper case."""
+    return code.strip().upper()
+
+
+@dataclass(frozen=True)
+class DiscountCode:
+    code: str
+    # The last day the code can be used, in the shop's timezone. None if it doesn't expire.
+    expires_on: date | None
+
+    kind: ClassVar[str]
+
+    def is_live(self, today: date) -> bool:
+        return self.expires_on is None or today <= self.expires_on
+
+    def check(self, today: date) -> None:
+        """Check that staff can create this code."""
+        if not CODE_PATTERN.match(self.code):
+            raise ValidationFailed(
+                "Codes must be 3 to 30 letters, digits and hyphens, e.g. SUMMER-20"
+            )
+        if not self.is_live(today):
+            raise ValidationFailed(f"The expiry date {self.expires_on} has already passed")
+
+    def adjustment(self, discountable: Money) -> Adjustment | None:
+        """What the code takes off `discountable`, the merchandise after the employee
+        discount. None if it takes nothing off."""
+        raise NotImplementedError
+
+
+@dataclass(frozen=True)
+class PercentOff(DiscountCode):
+    percent: int
+
+    kind: ClassVar[str] = "percent_off"
+
+    def check(self, today: date) -> None:
+        super().check(today)
+        if not 1 <= self.percent <= 100:
+            raise ValidationFailed("Percentage discount codes must be between 1 and 100%")
+
+    def adjustment(self, discountable: Money) -> Adjustment | None:
+        amount = discountable.percent(self.percent)
+        if amount.is_zero():
+            return None
+        return Adjustment(
+            kind="discount_code", description=f"{self.percent}% off with {self.code}", amount=amount
+        )
diff --git a/shop/repositories/discount_codes.py b/shop/repositories/discount_codes.py
new file mode 100644
index 0000000..aa461ea
--- /dev/null
+++ b/shop/repositories/discount_codes.py
@@ -0,0 +1,53 @@
+from datetime import date
+
+from shop.domain.discount_codes import DiscountCode, PercentOff
+from shop.domain.errors import Conflict, NotFound
+from shop.repositories.base import Repository
+
+
+def _discount_code(row) -> DiscountCode:
+    expires_on = date.fromisoformat(row["expires_on"]) if row["expires_on"] else None
+    match row["kind"]:
+        case PercentOff.kind:
+            return PercentOff(code=row["code"], expires_on=expires_on, percent=row["percent"])
+    raise ValueError(f"Unknown kind of discount code {row['kind']!r}")
+
+
+def _kind_columns(discount_code: DiscountCode) -> dict:
+    match discount_code:
+        case PercentOff(percent=percent):
+            return {"percent": percent}
+    raise ValueError(f"Can't save a {type(discount_code).__name__}")
+
+
+class DiscountCodeRepository(Repository):
+    def get(self, code: str) -> DiscountCode:
+        row = self.conn.execute("SELECT * FROM discount_codes WHERE code = ?", (code,)).fetchone()
+        if row is None:
+            raise NotFound(f"No discount code {code!r}")
+        return _discount_code(row)
+
+    def list(self) -> list[DiscountCode]:
+        return [
+            _discount_code(row)
+            for row in self.conn.execute("SELECT * FROM discount_codes ORDER BY code")
+        ]
+
+    def add(self, discount_code: DiscountCode) -> None:
+        if self.conn.execute(
+            "SELECT 1 FROM discount_codes WHERE code = ?", (discount_code.code,)
+        ).fetchone():
+            raise Conflict(f"There's already a discount code {discount_code.code!r}")
+        columns = {
+            "code": discount_code.code,
+            "kind": discount_code.kind,
+            "expires_on": discount_code.expires_on.isoformat()
+            if discount_code.expires_on
+            else None,
+            **_kind_columns(discount_code),
+        }
+        self.conn.execute(
+            f"INSERT INTO discount_codes ({', '.join(columns)})"
+            f" VALUES ({', '.join('?' for _ in columns)})",
+            list(columns.values()),
+        )
