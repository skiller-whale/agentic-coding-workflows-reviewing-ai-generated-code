+++ b/tests/services/test_checkout.py
@@ -1,5 +1,8 @@
+from datetime import UTC, date, datetime
+
 import pytest
 
+from shop import clock
 from shop.domain.errors import NotFound, PaymentDeclined, ValidationFailed
 from shop.domain.money import Money
 
@@ -95,3 +98,67 @@ def test_someone_elses_cart(services, make):
     bob, _ = make.customer()
     with pytest.raises(NotFound):
         services.checkout.place_order(bob, make.cart(alice, ("TEE", 1)), "tok_visa")
+
+
+def test_discount_code(services, make):
+    make.product("TEE", price="20.00")
+    make.discount_code("SUMMER20", percent=20)
+    customer, _ = make.customer()
+    cart_id = make.cart(customer, ("TEE", 1))
+
+    order = services.checkout.place_order(customer, cart_id, "tok_visa", discount_code="summer20")
+
+    assert [(a.kind, a.description, a.amount) for a in order.adjustments] == [
+        ("discount_code", "SUMMER20: 20% off", Money(400))
+    ]
+    assert order.tax == Money(267)
+    assert order.total == Money(1600 + 495)
+    assert order.loyalty_points_earned == 16
+
+
+def test_discount_code_stacks_with_employee_discount_and_points(services, make):
+    make.product("HOODIE", price="55.00")
+    make.discount_code("SUMMER20", percent=20)
+    customer, _ = make.customer(loyalty=1000, employee_discount=20)
+    cart_id = make.cart(customer, ("HOODIE", 1))
+
+    order = services.checkout.place_order(
+        customer, cart_id, "tok_visa", redeem_points=1000, discount_code="SUMMER20"
+    )
+
+    assert [(a.kind, a.amount) for a in order.adjustments] == [
+        ("employee", Money(1100)),
+        ("discount_code", Money(1100)),
+        ("loyalty", Money(1000)),
+    ]
+    assert order.total == Money(2300)
+
+
+def test_unknown_discount_code(services, make):
+    make.product("TEE")
+    customer, _ = make.customer()
+    cart_id = make.cart(customer, ("TEE", 1))
+    with pytest.raises(ValidationFailed, match="no discount code"):
+        services.checkout.place_order(customer, cart_id, "tok_visa", discount_code="NOPE")
+    assert services.orders.list_for_customer(customer) == []
+
+
+def test_expired_discount_code(services, make):
+    make.product("TEE")
+    make.discount_code("SPRING", expires_on=date(2026, 6, 14))
+    customer, _ = make.customer()
+    cart_id = make.cart(customer, ("TEE", 1))
+    with pytest.raises(ValidationFailed, match="expired"):
+        services.checkout.place_order(customer, cart_id, "tok_visa", discount_code="SPRING")
+
+
+def test_discount_code_expires_at_uk_midnight(services, make, monkeypatch):
+    make.product("TEE")
+    make.discount_code("SUMMER20", expires_on=date(2026, 6, 15))
+    customer, _ = make.customer()
+    # 23:30 UTC is 00:30 the next day in British Summer Time.
+    monkeypatch.setattr(clock, "now", lambda: datetime(2026, 6, 15, 23, 30, tzinfo=UTC))
+    with pytest.raises(ValidationFailed, match="expired"):
+        services.checkout.place_order(
+            customer, make.cart(customer, ("TEE", 1)), "tok_visa", discount_code="SUMMER20"
+        )
