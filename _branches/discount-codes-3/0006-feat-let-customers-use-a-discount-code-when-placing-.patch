 from shop.domain.errors import Conflict
-from shop.domain.models import DiscountCode
-from shop.repositories.base import Repository, to_db_time
+from shop.domain.models import DiscountCode, DiscountKind
+from shop.repositories.base import Repository, from_db_time, to_db_time
 
 
 class DiscountCodeRepository(Repository):
+    def find(self, code: str) -> DiscountCode | None:
+        row = self.conn.execute("SELECT * FROM discount_codes WHERE code = ?", (code,)).fetchone()
+        if row is None:
+            return None
+        return DiscountCode(
+            code=row["code"],
+            kind=DiscountKind(row["kind"]),
+            created_at=from_db_time(row["created_at"]),
+            percent=row["percent"],
+            expires_on=date.fromisoformat(row["expires_on"]) if row["expires_on"] else None,
+        )
+
     def add(self, discount: DiscountCode) -> None:
         if self.conn.execute(
             "SELECT 1 FROM discount_codes WHERE code = ?", (discount.code,)
