+
+
+def test_create_discount_code(client, staff_token):
+    response = client.post(
+        "/admin/discount-codes",
+        json={"code": "summer20", "percent": 20, "expires_on": "2026-08-31"},
+        headers=auth(staff_token),
+    )
+    assert response.status_code == 201
+    assert response.json() == {
+        "code": "SUMMER20",
+        "kind": "percent",
+        "percent": 20,
+        "expires_on": "2026-08-31",
+        "created_at": "2026-06-15T10:00:00+00:00",
+    }
+    [entry] = client.get(
+        "/admin/audit?subject=discount_code:SUMMER20", headers=auth(staff_token)
+    ).json()
+    assert entry["action"] == "discount_code.created"
+
+
+def test_discount_code_without_expiry(client, staff_token):
+    response = client.post(
+        "/admin/discount-codes", json={"code": "FOREVER", "percent": 10}, headers=auth(staff_token)
+    )
+    assert response.json()["expires_on"] is None
+
+
+def test_duplicate_discount_code(client, staff_token):
+    body = {"code": "SUMMER20", "percent": 20}
+    client.post("/admin/discount-codes", json=body, headers=auth(staff_token))
+    response = client.post("/admin/discount-codes", json=body, headers=auth(staff_token))
+    assert response.status_code == 409
+
+
+def test_discount_code_limits(client, staff_token):
+    response = client.post(
+        "/admin/discount-codes", json={"code": "HUGE", "percent": 101}, headers=auth(staff_token)
+    )
+    assert response.status_code == 422
+    assert response.json()["error"]["code"] == "validation_failed"
