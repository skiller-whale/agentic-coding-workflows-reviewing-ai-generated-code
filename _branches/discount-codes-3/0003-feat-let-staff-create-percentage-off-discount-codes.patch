@@ -0,0 +1,8 @@
+-- `kind` says how a code reduces the price. Each kind gets its own nullable columns.
+CREATE TABLE discount_codes (
+    code TEXT PRIMARY KEY,
+    kind TEXT NOT NULL,
+    percent INTEGER CHECK (percent BETWEEN 1 AND 100),
+    expires_on TEXT,
+    created_at TEXT NOT NULL
+);
diff --git a/shop/domain/discount_codes.py b/shop/domain/discount_codes.py
new file mode 100644
index 0000000..3a3a9c2
--- /dev/null
+++ b/shop/domain/discount_codes.py
@@ -0,0 +1,21 @@
+import re
+from datetime import date
+
+from shop.domain.errors import ValidationFailed
+from shop.domain.models import DiscountCode
+
+CODE_PATTERN = re.compile(r"^[A-Z0-9-]{3,20}$")
+
+
+def normalise(code: str) -> str:
+    """Codes are case-insensitive, so customers can type them however they like."""
+    return code.strip().upper()
+
+
+def check_new(discount: DiscountCode, today: date) -> None:
+    if not CODE_PATTERN.match(discount.code):
+        raise ValidationFailed("Codes must be 3 to 20 letters, digits or hyphens")
+    if discount.percent is None or not 1 <= discount.percent <= 100:
+        raise ValidationFailed("Discount codes must be for between 1 and 100%")
+    if discount.expires_on is not None and discount.expires_on < today:
+        raise ValidationFailed("That expiry date has already passed")
