--- /dev/null
+++ b/shop/services/discount_codes.py
@@ -0,0 +1,39 @@
+from datetime import date
+
+from shop import clock
+from shop.db.connection import transaction
+from shop.domain import discount_codes
+from shop.domain.models import DiscountCode, DiscountKind, StaffMember
+from shop.repositories.discount_codes import DiscountCodeRepository
+from shop.services.audit import AuditLog
+
+
+class DiscountCodeService:
+    def __init__(self, codes: DiscountCodeRepository, audit: AuditLog):
+        self.codes = codes
+        self.audit = audit
+
+    # --- staff ---
+
+    def create_percent_code(
+        self, staff: StaffMember, code: str, percent: int, expires_on: date | None = None
+    ) -> DiscountCode:
+        discount = DiscountCode(
+            code=discount_codes.normalise(code),
+            kind=DiscountKind.PERCENT,
+            created_at=clock.now(),
+            percent=percent,
+            expires_on=expires_on,
+        )
+        discount_codes.check_new(discount, clock.today())
+        with transaction(self.codes.conn):
+            self.codes.add(discount)
+            self.audit.record(
+                staff,
+                "discount_code.created",
+                f"discount_code:{discount.code}",
+                kind=discount.kind.value,
+                percent=percent,
+                expires_on=expires_on.isoformat() if expires_on else None,
+            )
+        return discount
diff --git a/tests/services/test_discount_codes.py b/tests/services/test_discount_codes.py
new file mode 100644
index 0000000..9e039cc
--- /dev/null
+++ b/tests/services/test_discount_codes.py
@@ -0,0 +1,58 @@
+from datetime import date
+
+import pytest
+
+from shop.domain.errors import Conflict, ValidationFailed
+from shop.domain.models import DiscountKind
+
+
+def test_create_percent_code_is_audited(services, make):
+    staff, _ = make.staff()
+    discount = services.discount_codes.create_percent_code(
+        staff, "summer20", 20, expires_on=date(2026, 8, 31)
+    )
+    assert (discount.code, discount.kind, discount.percent) == (
+        "SUMMER20",
+        DiscountKind.PERCENT,
+        20,
+    )
+    [entry] = services.audit.entries(subject="discount_code:SUMMER20")
+    assert entry.action == "discount_code.created"
+    assert entry.details == {"kind": "percent", "percent": 20, "expires_on": "2026-08-31"}
+
+
+def test_expiry_is_optional(services, make):
+    staff, _ = make.staff()
+    discount = services.discount_codes.create_percent_code(staff, "FOREVER", 10)
+    assert discount.expires_on is None
+
+
+def test_codes_are_unique_ignoring_case(services, make):
+    staff, _ = make.staff()
+    services.discount_codes.create_percent_code(staff, "SUMMER20", 20)
+    with pytest.raises(Conflict):
+        services.discount_codes.create_percent_code(staff, "Summer20", 10)
+
+
+@pytest.mark.parametrize("percent", [0, 101])
+def test_percent_limits(services, make, percent):
+    staff, _ = make.staff()
+    with pytest.raises(ValidationFailed):
+        services.discount_codes.create_percent_code(staff, "SUMMER20", percent)
+
+
+@pytest.mark.parametrize("code", ["AB", "SUMMER 20", "X" * 21, "SALE!"])
+def test_code_format(services, make, code):
+    staff, _ = make.staff()
+    with pytest.raises(ValidationFailed):
+        services.discount_codes.create_percent_code(staff, code, 20)
+
+
+def test_expiry_cant_be_in_the_past(services, make, frozen_clock):
+    staff, _ = make.staff()
+    with pytest.raises(ValidationFailed):
+        services.discount_codes.create_percent_code(staff, "LATE", 20, expires_on=date(2026, 6, 14))
+    today = services.discount_codes.create_percent_code(
+        staff, "TODAY", 20, expires_on=frozen_clock.date()
+    )
+    assert today.expires_on == date(2026, 6, 15)
