diff --git a/shop/repositories/discount_codes.py b/shop/repositories/discount_codes.py
new file mode 100644
index 0000000..017e548
--- /dev/null
+++ b/shop/repositories/discount_codes.py
@@ -0,0 +1,22 @@
+from shop.domain.errors import Conflict
+from shop.domain.models import DiscountCode
+from shop.repositories.base import Repository, to_db_time
+
+
+class DiscountCodeRepository(Repository):
+    def add(self, discount: DiscountCode) -> None:
+        if self.conn.execute(
+            "SELECT 1 FROM discount_codes WHERE code = ?", (discount.code,)
+        ).fetchone():
+            raise Conflict(f"There's already a discount code {discount.code!r}")
+        self.conn.execute(
+            "INSERT INTO discount_codes (code, kind, percent, expires_on, created_at)"
+            " VALUES (?, ?, ?, ?, ?)",
+            (
+                discount.code,
+                discount.kind.value,
+                discount.percent,
+                discount.expires_on.isoformat() if discount.expires_on else None,
+                to_db_time(discount.created_at),
+            ),
+        )
