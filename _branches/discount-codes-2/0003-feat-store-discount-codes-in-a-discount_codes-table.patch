diff --git a/shop/db/migrations/008_discount_codes.sql b/shop/db/migrations/008_discount_codes.sql
new file mode 100644
index 0000000..4c42c01
--- /dev/null
+++ b/shop/db/migrations/008_discount_codes.sql
@@ -0,0 +1,8 @@
+CREATE TABLE discount_codes (
+    code TEXT PRIMARY KEY,
+    kind TEXT NOT NULL,
+    -- For kind 'percent'. Nullable so that later kinds needn't have one.
+    percent INTEGER,
+    expires_on TEXT,
+    created_at TEXT NOT NULL
+);
diff --git a/shop/repositories/discount_codes.py b/shop/repositories/discount_codes.py
new file mode 100644
index 0000000..00f4b57
--- /dev/null
+++ b/shop/repositories/discount_codes.py
@@ -0,0 +1,36 @@
+from datetime import date
+
+from shop.domain.errors import Conflict, NotFound
+from shop.domain.models import DiscountCode
+from shop.repositories.base import Repository, from_db_time, to_db_time
+
+
+class DiscountCodeRepository(Repository):
+    def get(self, code: str) -> DiscountCode:
+        row = self.conn.execute("SELECT * FROM discount_codes WHERE code = ?", (code,)).fetchone()
+        if row is None:
+            raise NotFound(f"No discount code {code!r}")
+        return DiscountCode(
+            code=row["code"],
+            kind=row["kind"],
+            percent=row["percent"],
+            expires_on=date.fromisoformat(row["expires_on"]) if row["expires_on"] else None,
+            created_at=from_db_time(row["created_at"]),
+        )
+
+    def add(self, code: DiscountCode) -> None:
+        if self.conn.execute(
+            "SELECT 1 FROM discount_codes WHERE code = ?", (code.code,)
+        ).fetchone():
+            raise Conflict(f"There's already a discount code {code.code!r}")
+        self.conn.execute(
+            "INSERT INTO discount_codes (code, kind, percent, expires_on, created_at)"
+            " VALUES (?, ?, ?, ?, ?)",
+            (
+                code.code,
+                code.kind,
+                code.percent,
+                code.expires_on.isoformat() if code.expires_on else None,
+                to_db_time(code.created_at),
+            ),
+        )
