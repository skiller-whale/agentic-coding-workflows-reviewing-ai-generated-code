+    def discount_code(
+        self, code: str = "SUMMER10", percent: int = 10, expires_on: date | None = None
+    ) -> DiscountCode:
+        discount_code = DiscountCode(
+            code=code, kind=PERCENT, percent=percent, expires_on=expires_on, created_at=clock.now()
+        )
+        DiscountCodeRepository(self.conn).add(discount_code)
+        return discount_code
