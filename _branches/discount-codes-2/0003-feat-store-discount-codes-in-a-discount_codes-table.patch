+++ b/tests/repositories/test_discount_codes.py
@@ -0,0 +1,25 @@
+from datetime import date
+
+import pytest
+
+from shop.domain.errors import Conflict, NotFound
+from shop.repositories.discount_codes import DiscountCodeRepository
+
+
+def test_discount_codes_round_trip(conn, make):
+    with_expiry = make.discount_code("SUMMER10", percent=10, expires_on=date(2026, 8, 31))
+    without = make.discount_code("FOREVER5", percent=5)
+    repo = DiscountCodeRepository(conn)
+    assert repo.get("SUMMER10") == with_expiry
+    assert repo.get("FOREVER5") == without
+
+
+def test_duplicate_discount_code(make):
+    make.discount_code("SUMMER10")
+    with pytest.raises(Conflict):
+        make.discount_code("SUMMER10")
+
+
+def test_unknown_discount_code(conn):
+    with pytest.raises(NotFound):
+        DiscountCodeRepository(conn).get("NOPE")
