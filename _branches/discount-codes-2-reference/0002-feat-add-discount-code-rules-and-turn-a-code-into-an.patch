+import re
+from datetime import date
+
+from shop.domain.errors import ValidationFailed
+from shop.domain.models import Adjustment, DiscountCode
+from shop.domain.money import Money
+
+PERCENT = "percent"
+MAX_PERCENT = 50
+CODE_PATTERN = re.compile(r"[A-Z0-9]{3,20}")
+
+
+def normalise(code: str) -> str:
+    """Codes are case-insensitive, and stored in upper case."""
+    return code.strip().upper()
+
+
+def check_new(code: str, percent: int, expires_on: date | None, today: date) -> None:
+    if not CODE_PATTERN.fullmatch(code):
+        raise ValidationFailed("Discount codes must be 3 to 20 letters and digits")
+    if not 1 <= percent <= MAX_PERCENT:
+        raise ValidationFailed(f"Discount codes must be between 1 and {MAX_PERCENT}%")
+    if expires_on is not None and expires_on < today:
+        raise ValidationFailed("The expiry date has already passed")
+
+
+def discount(code: DiscountCode, merchandise: Money, today: date) -> Adjustment | None:
+    """The adjustment for a discount code, or None if it comes to nothing.
+
+    A code works until the end of its expiry date.
+    """
+    if code.expires_on is not None and today > code.expires_on:
+        raise ValidationFailed(f"The discount code {code.code} has expired")
+    amount = merchandise.percent(code.percent)
+    if amount.is_zero():
+        return None
+    return Adjustment(
+        kind="discount_code", description=f"{code.percent}% off with {code.code}", amount=amount
+    )
