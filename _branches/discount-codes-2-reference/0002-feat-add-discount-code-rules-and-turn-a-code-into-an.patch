+++ b/tests/domain/test_discount_codes.py
@@ -0,0 +1,69 @@
+from datetime import UTC, date, datetime
+
+import pytest
+
+from shop import clock
+from shop.domain.discount_codes import PERCENT, check_new, discount, normalise
+from shop.domain.errors import ValidationFailed
+from shop.domain.models import DiscountCode
+from shop.domain.money import Money
+
+TODAY = date(2026, 6, 15)
+
+
+def code(percent: int = 10, expires_on: date | None = None) -> DiscountCode:
+    return DiscountCode(
+        code="SUMMER10",
+        kind=PERCENT,
+        percent=percent,
+        expires_on=expires_on,
+        created_at=datetime(2026, 6, 1, tzinfo=UTC),
+    )
+
+
+def test_discount():
+    adjustment = discount(code(10), Money(1565), TODAY)
+    assert adjustment.kind == "discount_code"
+    assert adjustment.description == "10% off with SUMMER10"
+    assert adjustment.amount == Money(157)
+
+
+def test_discount_that_comes_to_nothing():
+    assert discount(code(1), Money(49), TODAY) is None
+
+
+def test_works_until_the_end_of_the_expiry_date():
+    assert discount(code(expires_on=TODAY), Money(2000), TODAY)
+    with pytest.raises(ValidationFailed, match="SUMMER10 has expired"):
+        discount(code(expires_on=date(2026, 6, 14)), Money(2000), TODAY)
+
+
+def test_normalise():
+    assert normalise(" summer10 ") == "SUMMER10"
+
+
+def test_check_new():
+    check_new("SUMMER10", 1, None, TODAY)
+    check_new("SUMMER10", 50, TODAY, TODAY)
+
+
+@pytest.mark.parametrize(
+    "new_code, percent, expires_on",
+    [
+        ("AB", 10, None),
+        ("SUMMER-10", 10, None),
+        ("A" * 21, 10, None),
+        ("SUMMER10", 0, None),
+        ("SUMMER10", 51, None),
+        ("SUMMER10", 10, date(2026, 6, 14)),
+    ],
+)
+def test_check_new_rejects(new_code, percent, expires_on):
+    with pytest.raises(ValidationFailed):
+        check_new(new_code, percent, expires_on, TODAY)
+
+
+def test_today_is_in_uk_time(monkeypatch):
+    # 23:30 UTC on 15 June is 00:30 on 16 June in British Summer Time.
+    monkeypatch.setattr(clock, "now", lambda: datetime(2026, 6, 15, 23, 30, tzinfo=UTC))
+    assert clock.today() == date(2026, 6, 16)
