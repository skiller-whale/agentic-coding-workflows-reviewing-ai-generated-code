+        "created_at": "2026-06-15T10:00:00+00:00",
+    }
+
+
+def test_create_discount_code_without_expiry(client, staff_token):
+    response = client.post(
+        "/admin/discount-codes", json={"code": "FOREVER5", "percent": 5}, headers=auth(staff_token)
+    )
+    assert response.json()["expires_on"] is None
+
+
+def test_create_discount_code_limits(client, staff_token):
+    response = client.post(
+        "/admin/discount-codes", json={"code": "HALFPLUS", "percent": 51}, headers=auth(staff_token)
+    )
+    assert response.status_code == 422
+    assert response.json()["error"]["code"] == "validation_failed"
+
+
+def test_create_duplicate_discount_code(client, make, staff_token):
+    make.discount_code("SUMMER10")
+    response = client.post(
+        "/admin/discount-codes", json={"code": "SUMMER10", "percent": 10}, headers=auth(staff_token)
+    )
+    assert response.status_code == 409
