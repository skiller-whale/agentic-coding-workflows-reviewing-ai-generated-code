+++ b/tests/services/test_discount_codes.py
@@ -0,0 +1,33 @@
+from datetime import date
+
+import pytest
+
+from shop.domain.errors import Conflict, ValidationFailed
+
+
+def test_create_percent_code_is_audited(services, make):
+    staff, _ = make.staff()
+    code = services.discount_codes.create_percent_code(
+        staff, "summer10", 10, expires_on=date(2026, 8, 31)
+    )
+    assert (code.code, code.kind, code.percent) == ("SUMMER10", "percent", 10)
+    [entry] = services.audit.entries(subject="discount_code:SUMMER10")
+    assert (entry.action, entry.details) == (
+        "discount_code.created",
+        {"percent": 10, "expires_on": "2026-08-31"},
+    )
+
+
+def test_duplicate_code_ignores_case(services, make):
+    staff, _ = make.staff()
+    services.discount_codes.create_percent_code(staff, "SUMMER10", 10)
+    with pytest.raises(Conflict):
+        services.discount_codes.create_percent_code(staff, "summer10", 20)
+
+
+def test_expiry_in_the_past(services, make):
+    # The clock is frozen at 15 June 2026.
+    staff, _ = make.staff()
+    with pytest.raises(ValidationFailed):
+        services.discount_codes.create_percent_code(staff, "SUMMER10", 10, date(2026, 6, 14))
+    assert services.audit.entries() == []
