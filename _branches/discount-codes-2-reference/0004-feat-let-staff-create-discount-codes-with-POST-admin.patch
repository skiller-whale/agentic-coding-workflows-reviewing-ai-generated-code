+from fastapi import APIRouter, Depends
+
+from shop.api.deps import get_services, require_staff
+from shop.api.schemas.admin import DiscountCodeIn, DiscountCodeOut
+from shop.domain.models import StaffMember
+from shop.services import Services
+
+router = APIRouter(prefix="/discount-codes")
+
+
+@router.post("", status_code=201)
+def create_discount_code(
+    body: DiscountCodeIn,
+    staff: StaffMember = Depends(require_staff),
+    services: Services = Depends(get_services),
+) -> DiscountCodeOut:
+    code = services.discount_codes.create_percent_code(
+        staff, body.code, body.percent, body.expires_on
+    )
+    return DiscountCodeOut.of(code)
