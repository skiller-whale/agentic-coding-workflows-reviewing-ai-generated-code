+
+
+def test_create_discount_code(client, staff_token):
+    response = client.post(
+        "/admin/discount-codes",
+        json={"code": "summer10", "percent": 10, "expires_on": "2026-08-31"},
+        headers=auth(staff_token),
+    )
+    assert response.status_code == 201
+    assert response.json() == {"code": "SUMMER10", "percent": 10, "expires_on": "2026-08-31"}
+    [entry] = client.get(
+        "/admin/audit?subject=discount_code:SUMMER10", headers=auth(staff_token)
+    ).json()
+    assert entry["action"] == "discount_code.created"
+
+
+def test_create_discount_code_without_expiry(client, staff_token):
+    response = client.post(
+        "/admin/discount-codes", json={"code": "WELCOME", "percent": 15}, headers=auth(staff_token)
+    )
+    assert response.json()["expires_on"] is None
+
+
+def test_create_discount_code_bad_percent(client, staff_token):
+    response = client.post(
+        "/admin/discount-codes", json={"code": "WELCOME", "percent": 0}, headers=auth(staff_token)
+    )
+    assert response.status_code == 422
+    assert response.json()["error"]["code"] == "validation_failed"
+
+
+def test_create_duplicate_discount_code(client, make, staff_token):
+    make.discount_code("WELCOME")
+    response = client.post(
+        "/admin/discount-codes", json={"code": "WELCOME", "percent": 15}, headers=auth(staff_token)
+    )
+    assert response.status_code == 409
