@@ -0,0 +1,21 @@
+import re
+from datetime import date
+
+from shop.domain.errors import ValidationFailed
+from shop.domain.models import DiscountCode
+
+CODE_PATTERN = re.compile(r"^[A-Z0-9-]{3,20}$")
+
+
+def normalise(code: str) -> str:
+    """Customers type codes in, so case and stray spaces shouldn't matter."""
+    return code.strip().upper()
+
+
+def check_new_code(code: DiscountCode, today: date) -> None:
+    if not CODE_PATTERN.match(code.code):
+        raise ValidationFailed("Codes must be 3 to 20 letters, digits or hyphens")
+    if not 1 <= code.percent <= 100:
+        raise ValidationFailed("Discount codes must be between 1 and 100%")
+    if code.has_expired(today):
+        raise ValidationFailed(f"{code.expires_on} has already passed")
