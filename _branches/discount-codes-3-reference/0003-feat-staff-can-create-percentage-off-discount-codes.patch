diff --git a/shop/services/discount_codes.py b/shop/services/discount_codes.py
new file mode 100644
index 0000000..40a5370
--- /dev/null
+++ b/shop/services/discount_codes.py
@@ -0,0 +1,34 @@
+from datetime import date
+
+from shop import clock
+from shop.db.connection import transaction
+from shop.domain import discount_codes
+from shop.domain.models import DiscountCode, StaffMember
+from shop.repositories.discount_codes import DiscountCodeRepository
+from shop.services.audit import AuditLog
+
+
+class DiscountCodeService:
+    def __init__(self, codes: DiscountCodeRepository, audit: AuditLog):
+        self.codes = codes
+        self.audit = audit
+
+    # --- staff ---
+
+    def create(
+        self, staff: StaffMember, code: str, percent: int, expires_on: date | None = None
+    ) -> DiscountCode:
+        discount_code = DiscountCode(
+            code=discount_codes.normalise(code), percent=percent, expires_on=expires_on
+        )
+        discount_codes.check_new_code(discount_code, clock.today())
+        with transaction(self.codes.conn):
+            self.codes.add(discount_code)
+            self.audit.record(
+                staff,
+                "discount_code.created",
+                f"discount_code:{discount_code.code}",
+                percent=percent,
+                expires_on=expires_on.isoformat() if expires_on else None,
+            )
+        return discount_code
diff --git a/tests/domain/test_discount_codes.py b/tests/domain/test_discount_codes.py
new file mode 100644
index 0000000..e873840
--- /dev/null
+++ b/tests/domain/test_discount_codes.py
@@ -0,0 +1,40 @@
+from datetime import date
+
+import pytest
+
+from shop.domain.discount_codes import check_new_code, normalise
+from shop.domain.errors import ValidationFailed
+from shop.domain.models import DiscountCode
+
+TODAY = date(2026, 6, 15)
+
+
+def test_normalise():
+    assert normalise(" summer10 ") == "SUMMER10"
+
+
+def test_expires_at_the_end_of_the_day():
+    code = DiscountCode("SUMMER10", 10, expires_on=TODAY)
+    assert not code.has_expired(TODAY)
+    assert code.has_expired(date(2026, 6, 16))
+    assert not DiscountCode("FOREVER", 10).has_expired(date(2099, 1, 1))
+
+
+@pytest.mark.parametrize("code", ["AB", "A" * 21, "SUMMER 10", "summer10"])
+def test_code_format(code):
+    with pytest.raises(ValidationFailed, match="letters, digits or hyphens"):
+        check_new_code(DiscountCode(code, 10), TODAY)
+
+
+def test_percent_limits():
+    check_new_code(DiscountCode("ONE", 1), TODAY)
+    check_new_code(DiscountCode("ALL", 100), TODAY)
+    for percent in (0, 101):
+        with pytest.raises(ValidationFailed, match="between 1 and 100%"):
+            check_new_code(DiscountCode("BAD", percent), TODAY)
+
+
+def test_cant_create_an_expired_code():
+    check_new_code(DiscountCode("LASTDAY", 10, expires_on=TODAY), TODAY)
+    with pytest.raises(ValidationFailed, match="already passed"):
+        check_new_code(DiscountCode("TOOLATE", 10, expires_on=date(2026, 6, 14)), TODAY)
