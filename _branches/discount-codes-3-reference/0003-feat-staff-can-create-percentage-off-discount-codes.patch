@@ -0,0 +1,30 @@
+from datetime import date
+
+import pytest
+
+from shop.domain.errors import Conflict
+from shop.domain.models import DiscountCode
+
+
+def test_create_is_audited(services, make):
+    staff, _ = make.staff()
+    code = services.discount_codes.create(staff, "summer10", 10, date(2026, 8, 31))
+    assert code == DiscountCode("SUMMER10", 10, date(2026, 8, 31))
+    [entry] = services.audit.entries(subject="discount_code:SUMMER10")
+    assert (entry.staff_id, entry.action, entry.details) == (
+        staff.id,
+        "discount_code.created",
+        {"percent": 10, "expires_on": "2026-08-31"},
+    )
+
+
+def test_create_without_expiry(services, make):
+    staff, _ = make.staff()
+    assert services.discount_codes.create(staff, "WELCOME", 15).expires_on is None
+
+
+def test_duplicate_code_ignores_case(services, make):
+    staff, _ = make.staff()
+    make.discount_code("SUMMER10")
+    with pytest.raises(Conflict):
+        services.discount_codes.create(staff, "Summer10", 20)
