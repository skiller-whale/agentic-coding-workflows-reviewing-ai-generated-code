diff --git a/tests/api/test_checkout_api.py b/tests/api/test_checkout_api.py
index 9ff3d72..739d75f 100644
--- a/tests/api/test_checkout_api.py
+++ b/tests/api/test_checkout_api.py
@@ -50,6 +50,41 @@ def test_employee_discount(client, make):
     assert order["total"] == "20.95"
 
 
+def test_discount_code(client, make):
+    make.product("TEE", price="20.00")
+    customer, token = make.customer()
+    make.discount_code("SUMMER10", percent=10)
+    order = client.post(
+        "/checkout",
+        json={
+            "cart_id": make.cart(customer, ("TEE", 1)),
+            "payment_token": "tok_visa",
+            "discount_code": "summer10",
+        },
+        headers=auth(token),
+    ).json()
+    assert order["adjustments"] == [
+        {"kind": "discount_code", "description": "SUMMER10: 10% off", "amount": "2.00"}
+    ]
+    assert order["total"] == "22.95"
+
+
+def test_unknown_discount_code(client, make):
+    make.product("TEE")
+    customer, token = make.customer()
+    response = client.post(
+        "/checkout",
+        json={
+            "cart_id": make.cart(customer, ("TEE", 1)),
+            "payment_token": "tok_visa",
+            "discount_code": "NOPE",
+        },
+        headers=auth(token),
+    )
+    assert response.status_code == 422
+    assert response.json()["error"]["code"] == "validation_failed"
+
+
 def test_declined(client, make):
     make.product("TEE")
     customer, token = make.customer()
