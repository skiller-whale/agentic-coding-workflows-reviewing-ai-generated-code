+++ b/shop/services/__init__.py
@@ -50,7 +50,9 @@ class Services:
             catalog=CatalogService(products, audit),
             customers=CustomerService(customers, tokens, audit),
             carts=carts,
-            checkout=CheckoutService(carts, cart_repo, customers, orders, gateway, settings),
+            checkout=CheckoutService(
+                carts, cart_repo, customers, orders, discount_codes, gateway, settings
+            ),
             orders=OrderService(orders, customers, audit, gateway),
             discount_codes=DiscountCodeService(discount_codes, audit),
             audit=audit,
diff --git a/shop/services/checkout.py b/shop/services/checkout.py
index 3f5ace1..fefb6a2 100644
--- a/shop/services/checkout.py
+++ b/shop/services/checkout.py
@@ -3,15 +3,16 @@ import logging
 from shop import clock
 from shop.config import Settings
 from shop.db.connection import transaction
