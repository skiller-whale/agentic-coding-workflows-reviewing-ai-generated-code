From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 13 Oct 2026 11:29:44 +0200
Subject: [PATCH 5/7] feat: apply a discount code at checkout as a
 discount_code adjustment

CheckoutService.place_order takes an optional discount_code. An unknown
or expired code is a ValidationFailed, raised before payment is taken.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 shop/domain/discount_codes.py       | 14 +++++++-
 shop/services/__init__.py           |  4 ++-
 shop/services/checkout.py           | 22 ++++++++++--
 tests/domain/test_discount_codes.py | 20 +++++++++--
 tests/services/test_checkout.py     | 54 +++++++++++++++++++++++++++++
 5 files changed, 107 insertions(+), 7 deletions(-)

diff --git a/shop/domain/discount_codes.py b/shop/domain/discount_codes.py
index 984b63c..e9519b3 100644
--- a/shop/domain/discount_codes.py
+++ b/shop/domain/discount_codes.py
@@ -2,7 +2,8 @@ import re
 from datetime import date
 
 from shop.domain.errors import ValidationFailed
-from shop.domain.models import DiscountCode
+from shop.domain.models import Adjustment, DiscountCode
+from shop.domain.money import Money
 
 CODE_PATTERN = re.compile(r"^[A-Z0-9-]{3,20}$")
 
@@ -19,3 +20,14 @@ def check_new_code(code: DiscountCode, today: date) -> None:
         raise ValidationFailed("Discount codes must be between 1 and 100%")
     if code.has_expired(today):
         raise ValidationFailed(f"{code.expires_on} has already passed")
+
+
+def discount(code: DiscountCode, merchandise: Money, today: date) -> Adjustment:
+    """The adjustment for using `code` on an order."""
+    if code.has_expired(today):
+        raise ValidationFailed(f"The discount code {code.code} expired on {code.expires_on}")
+    return Adjustment(
+        kind="discount_code",
+        description=f"{code.code}: {code.percent}% off",
+        amount=merchandise.percent(code.percent),
+    )
diff --git a/shop/services/__init__.py b/shop/services/__init__.py
index 54b5710..801c6bb 100644
